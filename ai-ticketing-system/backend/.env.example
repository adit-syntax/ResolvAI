# AI Ticketing System — Environment Variables
# Copy this file to .env and fill in your values

# ─── Security (REQUIRED in production) ───────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string-in-production

# JWT token expiry in minutes (default 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# In development: http://localhost:5173
# In production:  https://your-frontend.onrender.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ─── AI Keys ─────────────────────────────────────────────────────────────────
# Groq API Key (primary — fast LLM inference via Groq cloud)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic Claude API Key (optional — fallback if Groq unavailable)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (local dev):
DATABASE_URL=sqlite:///./ticketing.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Integrations (optional) ─────────────────────────────────────────────────
# Slack Webhook for real-time ticket alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ─── App Environment ─────────────────────────────────────────────────────────
# Set to "production" to disable Swagger UI (/docs)
ENVIRONMENT=development
